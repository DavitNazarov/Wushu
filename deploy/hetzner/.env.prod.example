# Production env for docker-compose.prod.yml (Hetzner deployment).
# Copy to .env.prod and fill in real values:
#   cp deploy/hetzner/.env.prod.example deploy/hetzner/.env.prod

# --- Postgres (compose `db` service) ---
POSTGRES_USER=wushu
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=geo_wushu

# --- App ---
# ≥32 random chars. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_random_chars
# Must match a seeded Organisation.slug.
PUBLIC_ORG_SLUG=georgian-wushu
# Public HTTPS origin (same value in both for the single-origin combined deploy).
FRONTEND_URL=https://wushu.example.com
CORS_ALLOWED_ORIGINS=https://wushu.example.com
# 'lax' for single-origin. Only 'none' (with HTTPS) for a cross-site split.
COOKIE_SAME_SITE=lax
LOG_LEVEL=info

# Canonical public origin for SEO/OpenGraph/sitemap (no trailing slash).
# Usually the same as FRONTEND_URL.
SITE_URL=https://wushu.example.com

# Optional backend error aggregation (Sentry). Leave empty to disable.
SENTRY_DSN=
