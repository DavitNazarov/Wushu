generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventLifecycle {
  REG_OPEN
  LOCKED
  WEIGHIN
  WEIGH_IN_COMPLETED
  DRAWN
  PUBLISHED
  LIVE
  COMPLETED
}

enum EventAccessType {
  OPEN
  CLOSED
}

enum RulesetStatus {
  DRAFT
  ACTIVE
}

enum UserRole {
  admin
  coach
  athlete
  judge
  timekeeper
}

enum SubmissionStatus {
  NEW
  HANDLED
}

enum RegistrationStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum WeighInDecision {
  PASS
  MOVED_UP
  REWEIGH
  FAIL
  ONE_HOUR
  DISQUALIFIED
}

enum WeighInStatus {
  NOT_WEIGHED
  PASSED
  MOVED_UP
  FAILED
  OVERRIDE_APPROVED
  REWEIGH_ALLOWED
  DISQUALIFIED
}

enum WeighInPolicyCode {
  IWUF_STRICT_ONE_HOUR
  MOVE_UP_AFTER_FAILED_REWEIGH
  DIRECT_MOVE_UP
  MANUAL_ADMIN_DECISION
}

enum BronzePolicyCode {
  TWO_BRONZES
}

enum RestPolicyCode {
  MIN_15_MINUTES
}

enum PublishTimingPolicyCode {
  IMMEDIATE_AFTER_DRAW
  MANUAL_PUBLISH_LATER
  COMPETITION_DAY_ONLY
}

enum FightStatus {
  QUEUED
  ON_DECK
  IN_PROGRESS
  PAUSED
  COMPLETE
  CONFIRMED
}

enum TimerStateEnum {
  IDLE
  RUNNING
  PAUSED
  FINISHED
}

enum TimerPhaseEnum {
  ROUND
  REST
  FINISHED
}

enum WinMethod {
  POINTS
  KO
  DQ
  WO
}

enum FightSlot {
  RED
  BLUE
}

enum AthleteSex {
  MALE
  FEMALE
}

// How a category's bracket is fought. Decided at draw time by athlete count
// (resolveCompetitionFormat): <=2 DIRECT_FINAL, 3 ROUND_ROBIN, 4+ SINGLE_ELIMINATION.
// Results placement logic branches on this — RR medals come from standings,
// not from a "final fight".
enum BracketFormat {
  DIRECT_FINAL
  ROUND_ROBIN
  SINGLE_ELIMINATION
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  events        Event[]
  categoryTemplates CategoryTemplate[]
  auditLogs     AuditLog[]
  newsPosts     NewsPost[]
  documents     DocumentLink[]
  clubs         Club[]
  contacts      ContactSubmission[]
  athletes      Athlete[]
  athleteMerges AthleteMerge[]
  registrations Registration[]
  weighIns      WeighInAttempt[]
  mats             Mat[]
  brackets         Bracket[]
  fights           Fight[]
  timerStates      TimerState[]
  scheduleSessions ScheduleSession[]
  countries        Country[]
  cities           City[]
  federations      Federation[]
  coaches          Coach[]
  protocolSignatureTemplates ProtocolSignatureTemplate[]
}

// Reusable head-judge signature block selected when exporting the results
// protocols PDF. Org-scoped; the signature image is stored inline as a base64
// data: URL (kept small by client-side downscaling).
model ProtocolSignatureTemplate {
  id             String   @id @default(cuid())
  organisationId String
  judgeNameEn    String
  judgeNameKa    String?
  signature      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
}

model User {
  id             String   @id @default(cuid())
  organisationId String
  email          String
  passwordHash   String
  displayName    String
  role           UserRole @default(athlete)
  clubId         String?
  cityId         String?
  countryId      String?
  nationality    String?
  isActive       Boolean  @default(true)
  deletedAt      DateTime?
  dqReason       String?
  dqStartAt      DateTime?
  dqEndAt        DateTime?
  dqNote         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation     @relation(fields: [organisationId], references: [id])
  club           Club?            @relation(fields: [clubId], references: [id])
  city           City?            @relation(fields: [cityId], references: [id])
  country        Country?         @relation(fields: [countryId], references: [id])
  coachProfile   Coach?
  capabilities   UserCapability[]
  auditLogs      AuditLog[]       @relation("AuditActor")
  weighIns       WeighInAttempt[] @relation("WeighInOperator")
  fightConfirms  Fight[]          @relation("FightConfirmedBy")
  timerUpdates   TimerState[]     @relation("TimerUpdatedBy")
  refreshTokens  RefreshToken[]
  drawCategoryReviews EventWeightCategory[] @relation("DrawCategoryReviewedBy")

  @@unique([organisationId, email])
  @@index([email])
  @@index([organisationId, deletedAt])
  @@index([cityId])
  @@index([countryId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Capability {
  id          String @id @default(cuid())
  code        String @unique
  description String

  users UserCapability[]
}

model UserCapability {
  userId       String
  capabilityId String

  assignedAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  capability Capability @relation(fields: [capabilityId], references: [id])

  @@id([userId, capabilityId])
}

model Event {
  id             String         @id @default(cuid())
  organisationId String
  name           String
  nameKa         String?
  slug           String
  location       String?
  /// Optional entry/participation fee per athlete (whole currency units, GEL).
  /// Drives the income tally on the admin registrations page and is shown on
  /// the public event overview. Null = no fee configured.
  entryFee       Int?
  timezone       String         @default("Asia/Tbilisi")
  lifecycle      EventLifecycle @default(REG_OPEN)
  published           Boolean        @default(false)
  autoAdvanceStage    Boolean        @default(false)
  accessType          EventAccessType @default(OPEN)
  // When true, the confirmed weigh-in weights for this event are exposed on the
  // public site (/events/:slug/weights). Toggled from the Weigh-In Results page.
  weighInResultsPublic Boolean       @default(false)
  weighInPolicyCode   WeighInPolicyCode      @default(IWUF_STRICT_ONE_HOUR)
  bronzePolicyCode    BronzePolicyCode       @default(TWO_BRONZES)
  restPolicyCode      RestPolicyCode         @default(MIN_15_MINUTES)
  minRestMinutes      Int                    @default(15)
  publishTimingPolicyCode PublishTimingPolicyCode @default(IMMEDIATE_AFTER_DRAW)
  reweighWindowMinutes Int                   @default(60)

  registrationStartDate DateTime
  registrationEndDate   DateTime
  weighInStartDate      DateTime?
  weighInEndDate        DateTime?
  competitionStartDate  DateTime
  competitionEndDate    DateTime

  /// When the online registration window opens. Can be before competitionStartDate.
  /// Null = legacy event; fall back to lifecycle-based check.
  registrationOpensAt  DateTime?
  /// When the online registration window closes (exclusive). Auto-set to start of first
  /// weigh-in/registration day when not supplied.
  registrationClosesAt DateTime?

  /// Canonical date-only model for the event.
  /// Structure:
  /// {
  ///   range: { startDate: "YYYY-MM-DD", endDate: "YYYY-MM-DD" },
  ///   registrationDays: string[],
  ///   fightDays: string[]
  /// }
  dates Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation    Organisation          @relation(fields: [organisationId], references: [id])
  categoryTemplateSnapshot EventCategoryTemplateSnapshot?
  auditLogs       AuditLog[]            @relation("AuditEvent")
  registrations   Registration[]
  weighIns        WeighInAttempt[]
  mats            Mat[]
  brackets        Bracket[]
  fights          Fight[]
  newsPosts       NewsPost[]
  eventAgeGroups  EventAgeGroup[]
  scheduleSessions ScheduleSession[]

  @@unique([organisationId, slug])
}

model CategoryTemplate {
  id             String        @id @default(cuid())
  organisationId String?
  name           String
  version        Int
  status         RulesetStatus @default(DRAFT)
  definition     Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation Organisation?              @relation(fields: [organisationId], references: [id])
  snapshots    EventCategoryTemplateSnapshot[]
  ageGroups    CategoryTemplateAgeGroup[]

  @@unique([organisationId, name, version])
}

model CategoryTemplateAgeGroup {
  id                   String     @id @default(cuid())
  categoryTemplateId   String     @map("rulesetId")
  code                 String
  name                 String
  nameKa               String?
  sex                  AthleteSex?
  minAge               Int?
  maxAge               Int?
  roundDurationSeconds Int        @default(120)
  sortOrder            Int        @default(0)

  categoryTemplate CategoryTemplate       @relation(fields: [categoryTemplateId], references: [id], onDelete: Cascade)
  weights          CategoryTemplateWeight[]
  eventAgeGroups   EventAgeGroup[]

  @@unique([categoryTemplateId, code])
  @@index([categoryTemplateId])
}

model CategoryTemplateWeight {
  id                String  @id @default(cuid())
  ageGroupId        String
  name              String
  minWeightKgExcl   Float?
  maxWeightKgIncl   Float?
  sortOrder         Int     @default(0)

  ageGroup        CategoryTemplateAgeGroup @relation(fields: [ageGroupId], references: [id], onDelete: Cascade)
  eventCategories EventWeightCategory[]

  @@index([ageGroupId])
}

model CategoryOptionGroup {
  id                   String     @id @default(cuid())
  code                 String     @unique
  name                 String
  nameKa               String?
  sex                  AthleteSex?
  minAge               Int?
  maxAge               Int?
  roundDurationSeconds Int        @default(120)
  sortOrder            Int        @default(0)
  isActive             Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  options CategoryOption[]

  @@index([isActive, sortOrder])
}

model CategoryOption {
  id              String   @id @default(cuid())
  groupId         String
  code            String   @unique
  name            String
  minWeightKgExcl Float?
  maxWeightKgIncl Float?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group CategoryOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, isActive, sortOrder])
}

model EventAgeGroup {
  id                         String @id @default(cuid())
  eventId                    String
  categoryTemplateAgeGroupId String @map("rulesetAgeGroupId")

  event                Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryTemplateAgeGroup CategoryTemplateAgeGroup @relation(fields: [categoryTemplateAgeGroupId], references: [id])
  weightCategories EventWeightCategory[]

  @@unique([eventId, categoryTemplateAgeGroupId])
  @@index([eventId])
}

model EventWeightCategory {
  id                       String @id @default(cuid())
  eventAgeGroupId          String
  categoryTemplateWeightId String @map("rulesetWeightCategoryId")

  eventAgeGroup         EventAgeGroup           @relation(fields: [eventAgeGroupId], references: [id], onDelete: Cascade)
  categoryTemplateWeight CategoryTemplateWeight @relation(fields: [categoryTemplateWeightId], references: [id])
  registrations         Registration[]          @relation("RegistrationFinalWeightCategory")
  initialRegistrations  Registration[]          @relation("RegistrationInitialWeightCategory")
  fights                Fight[]

  // Pre-draw "Mark as reviewed" sign-off. drawReviewSignature is a hash of the
  // flagged athlete pool at sign-off time; if the pool changes the signature no
  // longer matches and the review auto-expires (category returns to SOLO/REVIEW).
  drawReviewedAt      DateTime?
  drawReviewedById    String?
  drawReviewedBy      User?     @relation("DrawCategoryReviewedBy", fields: [drawReviewedById], references: [id])
  drawReviewSignature String?

  @@unique([eventAgeGroupId, categoryTemplateWeightId])
  @@index([eventAgeGroupId])
}

model EventCategoryTemplateSnapshot {
  id        String   @id @default(cuid())
  eventId   String   @unique
  categoryTemplateId String @map("rulesetId")
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())

  event            Event            @relation(fields: [eventId], references: [id])
  categoryTemplate CategoryTemplate @relation(fields: [categoryTemplateId], references: [id])

  @@map("EventRulesetSnapshot")
}

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String
  eventId        String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  reason         String?
  override       Boolean  @default(false)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  event        Event?       @relation("AuditEvent", fields: [eventId], references: [id])
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id])

  // DB-1: AuditLog grows one row per mutation and was completely unindexed —
  // every tenant-filtered audit read table-scanned.
  @@index([organisationId, createdAt])
  @@index([eventId, createdAt])
  @@index([entityType, entityId])
}

model NewsPost {
  id             String    @id @default(cuid())
  organisationId String
  eventId        String?
  title          String
  slug           String
  body           String
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  event        Event?       @relation(fields: [eventId], references: [id])

  @@unique([organisationId, slug])
}

model DocumentLink {
  id             String    @id @default(cuid())
  organisationId String
  title          String
  slug           String    @unique
  url            String
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])

  // DB-1: Postgres does not auto-index FK columns.
  @@index([organisationId])
}

// A country is the top of the geography hierarchy (Country → Region → Club).
// Org-scoped like everything else. `code` is ISO-3166 alpha-2 (e.g. "GE") and
// drives Georgian-only UI behaviour (bilingual names, 11-digit national IDs).
model Country {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  nameKa         String?
  code           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  cities       City[]
  federations  Federation[]
  clubs        Club[]
  coaches      User[]
  coachRoster  Coach[]
  athletes     Athlete[]

  @@unique([organisationId, name])
  @@index([organisationId])
}

// A city belongs to a country and groups federations/clubs (e.g. Tbilisi, Kutaisi).
// Hierarchy: Country -> City -> Federation -> Club -> Coach -> Athlete.
model City {
  id             String   @id @default(cuid())
  organisationId String
  countryId      String
  name           String
  nameKa         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  country      Country      @relation(fields: [countryId], references: [id])
  federations  Federation[]
  clubs        Club[]
  coaches      User[]
  coachRoster  Coach[]
  athletes     Athlete[]

  @@unique([organisationId, countryId, name])
  @@index([organisationId])
  @@index([countryId])
}

// A federation belongs to a city and groups clubs (e.g. "Tbilisi Wushu Federation").
model Federation {
  id             String   @id @default(cuid())
  organisationId String
  countryId      String
  cityId         String
  name           String
  nameKa         String?
  isOfficial     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  country      Country      @relation(fields: [countryId], references: [id])
  city         City         @relation(fields: [cityId], references: [id])
  clubs        Club[]

  @@unique([organisationId, cityId, name])
  @@index([organisationId])
  @@index([cityId])
  @@index([countryId])
}

model Club {
  id             String   @id @default(cuid())
  organisationId String
  countryId      String
  cityId         String
  federationId   String?
  name           String
  nameKa         String?
  isOfficial     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation  Organisation   @relation(fields: [organisationId], references: [id])
  country       Country        @relation(fields: [countryId], references: [id])
  city          City           @relation(fields: [cityId], references: [id])
  federation    Federation?    @relation(fields: [federationId], references: [id])
  coaches       User[]
  coachRoster   Coach[]
  athletes      Athlete[]
  athleteMemberships AthleteClub[]
  registrations Registration[]

  // DB-1: FK column was unindexed.
  @@index([organisationId])
  @@index([cityId])
  @@index([federationId])
  @@index([countryId])
}

// A coach belongs to a club. Athletes link to coaches many-to-many (an athlete
// can train under several coaches). A coach optionally has a login User account.
model Coach {
  id             String   @id @default(cuid())
  organisationId String
  countryId      String?
  cityId         String?
  clubId         String?
  firstName      String
  firstNameKa    String?
  lastName       String
  lastNameKa     String?
  nationality    String?
  userId         String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id])
  country      Country?       @relation(fields: [countryId], references: [id])
  city         City?          @relation(fields: [cityId], references: [id])
  club         Club?          @relation(fields: [clubId], references: [id])
  user         User?          @relation(fields: [userId], references: [id])
  athletes     AthleteCoach[]

  @@index([organisationId])
  @@index([clubId])
  @@index([cityId])
  @@index([countryId])
}

// Join table: athlete <-> coach (many-to-many).
model AthleteCoach {
  athleteId String
  coachId   String

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  coach   Coach   @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@id([athleteId, coachId])
  @@index([coachId])
}

// Join table: athlete <-> club (many-to-many). Athlete.clubId remains the
// primary/default club for backwards compatibility; this table stores every
// club the athlete can belong to.
model AthleteClub {
  athleteId String
  clubId    String
  createdAt DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([athleteId, clubId])
  @@index([clubId])
}

model ContactSubmission {
  id             String           @id @default(cuid())
  organisationId String
  type           String
  name           String
  email          String
  message        String
  clubName       String?
  status         SubmissionStatus @default(NEW)
  createdAt      DateTime         @default(now())
  handledAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id])

  // DB-1: FK column was unindexed.
  @@index([organisationId])
}

model Athlete {
  id             String      @id @default(cuid())
  organisationId String
  clubId         String?
  cityId         String?
  countryId      String?
  firstName      String
  firstNameKa    String?
  lastName       String
  lastNameKa     String?
  dateOfBirth    DateTime
  documentId     String
  sex            AthleteSex?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  club           Club?          @relation(fields: [clubId], references: [id])
  city           City?          @relation(fields: [cityId], references: [id])
  country        Country?       @relation(fields: [countryId], references: [id])
  coaches        AthleteCoach[]
  clubMemberships AthleteClub[]
  registrations  Registration[]
  redFights      Fight[]        @relation("FightRedAthlete")
  blueFights     Fight[]        @relation("FightBlueAthlete")
  wonFights      Fight[]        @relation("FightWinner")
  lostFights     Fight[]        @relation("FightLoser")
  mergedFrom     AthleteMerge[] @relation("MergePrimary")
  mergedInto     AthleteMerge[] @relation("MergeSecondary")

  @@unique([organisationId, documentId])
  @@index([organisationId, lastName, firstName])
  @@index([organisationId, dateOfBirth, documentId])
  @@index([cityId])
  @@index([countryId])
}

model AthleteMerge {
  id                String   @id @default(cuid())
  organisationId    String
  primaryAthleteId  String
  secondaryAthleteId String
  reason            String
  mergedByUserId    String?
  createdAt         DateTime @default(now())

  organisation     Organisation @relation(fields: [organisationId], references: [id])
  primaryAthlete   Athlete      @relation("MergePrimary", fields: [primaryAthleteId], references: [id])
  secondaryAthlete Athlete      @relation("MergeSecondary", fields: [secondaryAthleteId], references: [id])

  // DB-1: FK column was unindexed.
  @@index([organisationId])
}

model Registration {
  id                    String             @id @default(cuid())
  organisationId        String
  eventId               String
  athleteId             String
  clubId                String?
  categoryCode          String
  eventWeightCategoryId String?
  registeredEventWeightCategoryId String?
  status                RegistrationStatus @default(PENDING)
  weighInStatus         WeighInStatus      @default(NOT_WEIGHED)
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organisation        Organisation        @relation(fields: [organisationId], references: [id])
  event               Event               @relation(fields: [eventId], references: [id])
  athlete             Athlete             @relation(fields: [athleteId], references: [id])
  club                Club?               @relation(fields: [clubId], references: [id])
  eventWeightCategory EventWeightCategory? @relation("RegistrationFinalWeightCategory", fields: [eventWeightCategoryId], references: [id])
  registeredEventWeightCategory EventWeightCategory? @relation("RegistrationInitialWeightCategory", fields: [registeredEventWeightCategoryId], references: [id])
  weighIns            WeighInAttempt[]

  @@unique([eventId, athleteId])
  @@index([organisationId, eventId])
  @@index([organisationId, eventId, status])
  @@index([eventWeightCategoryId])
  @@index([registeredEventWeightCategoryId])
  @@index([weighInStatus])
}

model WeighInAttempt {
  id             String          @id @default(cuid())
  organisationId String
  eventId        String
  registrationId String
  attemptNo      Int
  weightKg       Float
  decision       WeighInDecision
  policyCode     WeighInPolicyCode @default(IWUF_STRICT_ONE_HOUR)
  deadlineAt     DateTime?
  resolvedAt     DateTime?
  resolvedAction String?
  operatorUserId String?
  override       Boolean         @default(false)
  reason         String?
  createdAt      DateTime        @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  registration Registration @relation(fields: [registrationId], references: [id])
  operator     User?        @relation("WeighInOperator", fields: [operatorUserId], references: [id])

  @@unique([registrationId, attemptNo])
  @@index([organisationId, eventId])
  @@index([registrationId])
  @@index([policyCode])
}

model Mat {
  id             String @id @default(cuid())
  organisationId String
  eventId        String
  name           String
  order          Int

  organisation Organisation @relation(fields: [organisationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  fights       Fight[]

  @@unique([eventId, name])
  @@index([organisationId, eventId])
}

model ScheduleSession {
  id             String   @id @default(cuid())
  organisationId String
  eventId        String
  name           String
  nameKa         String?
  startTime      DateTime
  endTime        DateTime
  order          Int

  organisation Organisation @relation(fields: [organisationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  fights       Fight[]

  @@index([organisationId, eventId])
}

model Bracket {
  id             String   @id @default(cuid())
  organisationId String
  eventId        String
  categoryCode   String
  seed           Int?
  format         BracketFormat @default(SINGLE_ELIMINATION)
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  fights       Fight[]

  @@unique([eventId, categoryCode])
  @@index([organisationId, eventId])
}

model Fight {
  id             String      @id @default(cuid())
  organisationId String
  eventId        String
  bracketId      String?
  categoryCode   String
  eventWeightCategoryId String?
  roundDurationSeconds  Int?
  round          Int
  boutNo         Int

  redAthleteId  String?
  blueAthleteId String?
  status        FightStatus @default(QUEUED)

  matId              String?
  orderInMat         Int?
  scheduledStartTime DateTime?
  sessionId          String?
  orderInSession     Int?

  winnerAthleteId   String?
  loserAthleteId    String?
  winMethod         WinMethod?
  notes             String?
  confirmedByUserId String?
  confirmedAt       DateTime?
  nextFightId       String?
  nextFightSlot     FightSlot?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation        Organisation         @relation(fields: [organisationId], references: [id])
  event               Event                @relation(fields: [eventId], references: [id])
  bracket             Bracket?             @relation(fields: [bracketId], references: [id])
  mat                 Mat?                 @relation(fields: [matId], references: [id])
  scheduleSession     ScheduleSession?     @relation(fields: [sessionId], references: [id])
  redAthlete          Athlete?             @relation("FightRedAthlete", fields: [redAthleteId], references: [id])
  blueAthlete         Athlete?             @relation("FightBlueAthlete", fields: [blueAthleteId], references: [id])
  winnerAthlete       Athlete?             @relation("FightWinner", fields: [winnerAthleteId], references: [id])
  loserAthlete        Athlete?             @relation("FightLoser", fields: [loserAthleteId], references: [id])
  confirmedBy         User?                @relation("FightConfirmedBy", fields: [confirmedByUserId], references: [id])
  eventWeightCategory EventWeightCategory? @relation(fields: [eventWeightCategoryId], references: [id])
  nextFight           Fight?               @relation("FightProgression", fields: [nextFightId], references: [id])
  sourceFights        Fight[]              @relation("FightProgression")
  timerState          TimerState?

  @@index([organisationId, eventId])
  @@index([organisationId, eventId, status])
  @@index([matId, orderInMat])
  @@index([sessionId, orderInSession])
  @@index([eventWeightCategoryId])
  @@index([nextFightId])
}

model TimerState {
  fightId        String         @id
  organisationId String
  state          TimerStateEnum @default(IDLE)
  phase          TimerPhaseEnum @default(ROUND)
  round          Int            @default(1)
  startedAt      DateTime?
  pausedAt       DateTime?
  pausedMs       Int            @default(0)
  phaseDurationSeconds Int      @default(120)
  roundDurationSeconds Int      @default(120)
  restDurationSeconds  Int      @default(60)
  redRoundWins        Int       @default(0)
  blueRoundWins       Int       @default(0)
  round1Winner        FightSlot?
  round2Winner        FightSlot?
  round3Winner        FightSlot?
  updatedAt      DateTime       @updatedAt
  updatedByUserId String?

  fight       Fight  @relation(fields: [fightId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])
  updatedBy   User?  @relation("TimerUpdatedBy", fields: [updatedByUserId], references: [id])

  // DB-1 / DB-11: FK column unindexed, and the 1s timer-automation cron scans
  // for RUNNING timers every tick — index `state` (scoped by org) so it doesn't
  // sequential-scan a table that grows with every historical fight.
  @@index([organisationId])
  @@index([organisationId, state])
}
