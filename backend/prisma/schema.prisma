generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventLifecycle {
  REG_OPEN
  WEIGHIN
  LOCKED
  DRAWN
  PUBLISHED
  LIVE
  COMPLETED
}

enum RulesetStatus {
  DRAFT
  ACTIVE
}

enum UserRole {
  admin
  coach
  athlete
}

enum SubmissionStatus {
  NEW
  HANDLED
}

model Organisation {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  events     Event[]
  rulesets   Ruleset[]
  auditLogs  AuditLog[]
  newsPosts  NewsPost[]
  documents  DocumentLink[]
  clubs      Club[]
  contacts   ContactSubmission[]
}

model User {
  id             String   @id @default(cuid())
  organisationId String
  email          String   @unique
  passwordHash   String
  displayName    String
  role           UserRole @default(athlete)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  capabilities UserCapability[]
  auditLogs    AuditLog[]  @relation("AuditActor")
}

model Capability {
  id          String  @id @default(cuid())
  code        String  @unique
  description String

  users UserCapability[]
}

model UserCapability {
  userId       String
  capabilityId String

  assignedAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  capability Capability @relation(fields: [capabilityId], references: [id])

  @@id([userId, capabilityId])
}

model Event {
  id             String  @id @default(cuid())
  organisationId String
  name           String
  slug           String  @unique
  startDate      DateTime?
  endDate        DateTime?
  location       String?
  lifecycle      EventLifecycle @default(REG_OPEN)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id])
  rulesetSnapshot EventRulesetSnapshot?
  auditLogs       AuditLog[]         @relation("AuditEvent")
}

model Ruleset {
  id             String  @id @default(cuid())
  organisationId String?
  name           String
  version        Int
  status         RulesetStatus @default(DRAFT)
  definition     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation?         @relation(fields: [organisationId], references: [id])
  snapshots     EventRulesetSnapshot[]

  @@unique([organisationId, name, version])
}

model EventRulesetSnapshot {
  id         String  @id @default(cuid())
  eventId    String  @unique
  rulesetId  String
  version    Int
  snapshot   Json
  createdAt  DateTime @default(now())

  event   Event   @relation(fields: [eventId], references: [id])
  ruleset Ruleset @relation(fields: [rulesetId], references: [id])
}

model AuditLog {
  id             String  @id @default(cuid())
  organisationId String
  eventId        String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  reason         String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  event        Event?       @relation("AuditEvent", fields: [eventId], references: [id])
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id])
}

model NewsPost {
  id             String   @id @default(cuid())
  organisationId String
  title          String
  slug           String   @unique
  body           String
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
}

model DocumentLink {
  id             String   @id @default(cuid())
  organisationId String
  title          String
  slug           String   @unique
  url            String
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
}

model Club {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  city           String?
  country        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
}

model ContactSubmission {
  id             String           @id @default(cuid())
  organisationId String
  type           String
  name           String
  email          String
  message        String
  clubName       String?
  status         SubmissionStatus @default(NEW)
  createdAt      DateTime         @default(now())
  handledAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id])
}
