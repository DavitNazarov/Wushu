{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": [
    "k6"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "k6"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "load-test/**/*.{mjs,js}"
      ],
      "project": [
        "*.js",
        "load-test/**/*.{mjs,js}"
      ]
    },
    "backend": {
      "entry": [
        "src/main.ts",
        "prisma/seed-*.ts",
        "scripts/**/*.mjs",
        "src/**/*.spec.ts",
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.mjs"
      ]
    },
    "frontend": {
      "entry": [
        "src/instrumentation*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignore": [
        "src/components/ui/primitives/**"
      ]
    }
  }
}
