{
  "name": "geo-wushu",
  "version": "3.0.1",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run prisma:studio\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",

    "prisma:studio": "npm run prisma:studio -w backend",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "db:dump:local": "npm run db:dump:local -w backend",
    "db:restore:neon": "npm run db:restore:neon -w backend",

    "build": "npm run build -w backend && npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "lint": "npm run lint -w frontend",
    "start": "node server.js"
  },
  
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
